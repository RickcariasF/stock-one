{
  "name": "stock-one",
  "version": "0.1.0",
  "private": true,
  "description": "Stock One: catálogo estático de sneakers con pedidos por WhatsApp y editor local sin login ni base de datos.",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node scripts/postbuild.mjs",
    "preview": "wrangler dev --local --port 8787",
    "editor": "tsx editor/server/index.ts",
    "migrate:brands": "tsx scripts/migrate-brands.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.6",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.3",
    "hono": "4.13.14",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "wrangler": "4.156.0"
  }
}
